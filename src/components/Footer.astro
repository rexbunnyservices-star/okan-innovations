---
import { site } from '@lib/content';
---

<footer class="footer">
  <div class="container footer__inner glass card-radius">
    <div>
      <h4>{site.name}</h4>
      <p>{site.description}</p>
    </div>
    <div class="footer__meta">
      <p>© {new Date().getFullYear()} {site.name}.</p>
      <p class="tiny">Built with minimal, performant Astro + glassmorphism.</p>
    </div>
  </div>
  <style>
    .footer {
      padding: var(--space-xl) var(--space-md) var(--space-lg);
    }
    .footer__inner {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-lg);
      padding: var(--space-lg);
    }
    .footer__meta {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      text-align: right;
    }
    .tiny {
      font-size: 0.88rem;
    }
    @media (min-width: 760px) {
      .footer__inner {
        flex-direction: row;
      }
      .footer__meta {
        text-align: right;
      }
    }
  </style>
</footer>
