---
import Layout from '@layouts/Layout.astro';
import { hero, about, stats, process, services, projects } from '@lib/content';
import { u } from '@lib/urls';
import GlassCard from '@components/GlassCard.astro';
---

<Layout>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy reveal">
        <span class="eyebrow pill glass">{hero.eyebrow}</span>
        <h1>{hero.title}</h1>
        <p class="lead">{hero.text}</p>
        <div class="hero__actions">
          <a class="btn primary" href={u('/contact')}>Get a Quote</a>
          <a class="btn ghost pill glass" href={u('/projects')}>See Our Work</a>
        </div>
      </div>
      <div class="hero__media reveal">
        <div class="hero__orb" aria-hidden="true"></div>
        <figure class="hero__figure glass card-radius">
          <img src={u(hero.image)} alt="Modern contemporary villa exterior — bright, airy" loading="eager" />
        </figure>
        <GlassCard class="hero__chip" title={hero.chip.title} text={hero.chip.text} icon="ri-clipboard-line" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container stats__strip glass pill reveal">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: var(--space-xl);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero__copy h1 {
    white-space: pre-line;
  }
  .eyebrow {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    margin-bottom: var(--space-md);
    font-size: 0.98rem;
  }
  .lead {
    max-width: 60ch;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
  }
  .btn.primary {
    background: linear-gradient(120deg, #2b6cf6, #3a7bff);
    color: var(--accent-ink);
    box-shadow: var(--shadow-elevated);
  }
  .btn.primary::after {
    content: '\ea6c';
    font-family: 'remixicon';
  }
  .btn.ghost {
    color: var(--ink-primary);
  }
  .hero__media {
    position: relative;
    display: grid;
    place-items: center;
  }
  .hero__orb {
    position: absolute;
    inset: 10% 15% -10% 15%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, rgba(255,255,255,0.9), rgba(43,108,246,0.25));
    filter: blur(40px);
    opacity: 0.9;
    pointer-events: none;
  }
  .hero__figure {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/5;
    width: min(560px, 90vw);
  }
  .hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__chip {
    position: absolute;
    left: clamp(1rem, 1vw, 2rem);
    bottom: clamp(1rem, 1vw, 2rem);
    max-width: min(280px, 80vw);
  }
  .stats__strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    padding: 1rem 1.25rem;
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.25rem;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.75rem + 1.25vw, 2.75rem);
    letter-spacing: -0.02em;
  }
  .stat__label {
    color: var(--ink-tertiary);
  }
  @media (min-width: 720px) {
    .hero__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stats__strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
