---
import Layout from '@layouts/Layout.astro';
import { hero, stats, zones, zonesHeader } from '@lib/content';
import { u } from '@lib/urls';
import GlassCard from '@components/GlassCard.astro';
---

<Layout>
  <section class="hero hero--bleed warm">
    <img class="hero__bg" src={u(hero.image)} alt="Mountain villa at sunset — warm architectural photography" width="1920" height="1281" loading="eager" fetchpriority="high" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__content reveal">
      <div class="container hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow pill glass">{hero.eyebrow}</span>
          <h1>Spaces That <span class="gold">Inspire</span></h1>
          <p class="lead">{hero.text}</p>
          <div class="hero__actions">
            <a class="btn primary pill" href={u('/projects')}>Explore Our Work <span class="arrow" aria-hidden="true">→</span></a>
            <a class="btn ghost pill" href={u('/contact')}>Start a Project <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
    <GlassCard class="hero__chip" title={hero.chip.title} text={hero.chip.text} icon="ri-clipboard-line" />
  </section>

  <section class="hero hero--bleed warm hero--zones">
    <img class="hero__bg" id="zoneImg" src={u(zones[0].image)} alt="Bedroom — Okan Innovations" width="1920" height="1281" loading="lazy" />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__content reveal">
      <div class="container hero__grid">
        <div class="hero__copy reveal">
          <span class="eyebrow pill glass">{zonesHeader.eyebrow}</span>
          <h2>{zonesHeader.title}</h2>
          <p class="lead">{zonesHeader.text}</p>
        </div>
        <nav class="hero__pills reveal" role="radiogroup" aria-label="Room zone">
          {zones.map((z) => (
            <button class={`hero__pill ${z.id === 'bedroom' ? 'active' : ''}`} role="radio" aria-checked={z.id === 'bedroom'} data-src={u(z.image)}>{z.label}</button>
          ))}
        </nav>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container stats__strip glass pill reveal">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat__value">{s.value}</span>
          <span class="stat__label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero--bleed {
    position: relative;
    min-height: 86svh;
    padding: 0;
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.45s ease;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(62,39,35,.72) 0%, rgba(62,39,35,.46) 30%, rgba(62,39,35,.12) 60%, transparent 80%);
  }
  @media (max-width: 879px) {
    .hero__scrim {
      background: linear-gradient(180deg, rgba(62,39,35,.48) 0%, rgba(62,39,35,.24) 40%, rgba(62,39,35,.86) 100%);
    }
  }
  .hero__content {
    position: relative;
    z-index: 2;
    min-height: 86svh;
    display: flex;
    align-items: center;
    padding-top: clamp(2rem, 2vw, 3rem);
    padding-bottom: clamp(2rem, 2vw, 3rem);
  }
  .hero--bleed.warm {
    --ink-primary: #ffffff;
    --ink-secondary: rgba(255,255,255,.84);
    --ink-tertiary: rgba(255,255,255,.64);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    width: 100%;
  }
  .hero__copy h1 {
    white-space: pre-line;
  }
  .hero__copy h2 {
    margin-bottom: var(--space-md);
  }
  .gold {
    color: #ffd166;
  }
  .hero__copy .lead {
    max-width: 50ch;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.7rem;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .btn.primary {
    background: var(--accent);
    color: var(--accent-ink);
    box-shadow: var(--shadow-elevated);
  }
  .btn.ghost {
    color: var(--ink-primary);
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--border-glass);
  }
  .btn:focus-visible,
  .hero__pill:focus-visible,
  .nav__burger:focus-visible,
  .nav__link:focus-visible,
  .nav__menu-link:focus-visible,
  .nav__menu-cta:focus-visible,
  .nav__cta:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }
  .arrow {
    font-size: 0.85em;
  }
  .hero__chip {
    position: absolute;
    left: clamp(1rem, 1vw, 2rem);
    bottom: clamp(1rem, 1vw, 2rem);
    max-width: min(280px, 80vw);
    pointer-events: none;
  }

  .hero__pills {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }
  .hero__pill {
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-glass);
    background: var(--surface-glass);
    color: var(--ink-secondary);
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 120ms ease;
  }
  .hero__pill.active {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: transparent;
  }
  .stats__strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    padding: 1rem 1.25rem;
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 0.25rem;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.75rem + 1.25vw, 2.75rem);
    letter-spacing: -0.02em;
  }
  .stat__label {
    color: var(--ink-tertiary);
  }
  @media (min-width: 880px) {
    .hero__grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-2xl);
      align-items: center;
    }
  }
  @media (min-width: 720px) {
    .stats__strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  const pills = document.querySelectorAll('.hero__pill');
  const img = document.getElementById('zoneImg');
  pills.forEach((p) => {
    p.addEventListener('click', () => {
      const next = p.dataset.src;
      if (!next || img.src.endsWith(next)) return;
      img.style.opacity = 0;
      setTimeout(() => { img.src = next; img.style.opacity = 1; }, 350);
      pills.forEach((x) => {
        x.classList.remove('active');
        x.setAttribute('aria-checked', 'false');
      });
      p.classList.add('active');
      p.setAttribute('aria-checked', 'true');
    });
  });
</script>
