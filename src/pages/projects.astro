---
import Layout from '@layouts/Layout.astro';
import { projects } from '@lib/content';
import { u } from '@lib/urls';
---

<Layout>
  <section>
    <div class="container">
      <header class="page-head reveal">
        <span class="eyebrow pill glass">Projects</span>
        <h1>A small selection of delivered work.</h1>
        <p>Every project shown here ran under a single Design-and-Build contract.</p>
      </header>
      <div class="mosaic">
        {projects.map((p, i) => (
          <article class={`tile glass card-radius reveal`} style={`--i:${i}`}>
            <figure class="tile__media">
              <img src={u(p.image)} alt={`${p.title}, ${p.location}`} loading="lazy" />
            </figure>
            <div class="tile__content">
              <div class="tile__top">
                <span class="pill glass tag">{p.category}</span>
                <span class="year">{p.year}</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <span class="location">{p.location}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    margin-bottom: var(--space-xl);
    max-width: 80ch;
  }
  .eyebrow {
    display: inline-flex;
    padding: 0.5rem 0.9rem;
    margin-bottom: var(--space-md);
  }
  .mosaic {
    display: grid;
    gap: var(--space-lg);
  }
  .tile {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .tile__media {
    margin: 0;
    aspect-ratio: 16/10;
    overflow: hidden;
  }
  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
  }
  .tile__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tag {
    padding: 0.4rem 0.8rem;
    font-size: 0.92rem;
  }
  .year,
  .location {
    color: var(--ink-tertiary);
  }
  @media (min-width: 860px) {
    .mosaic {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
  }
</style>
